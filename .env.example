# Database: use PostgreSQL for shared/production use. SQLite is the local fallback.
DATABASE_URL=sqlite:///./venufin.db
# DATABASE_URL=postgresql+psycopg://venufin:change-me@localhost:5432/venufin

# Hosted single-owner deployment. Keep the same random APP_INTERNAL_TOKEN in the
# frontend and backend hosts; it is a server-to-server secret, never NEXT_PUBLIC_*.
APP_ENV=development
APP_USERNAME=owner
APP_PASSWORD=
APP_INTERNAL_TOKEN=
# Optional when the API is called directly from a different web origin.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Set this to durable mounted storage on your backend host.
UPLOADS_DIR=

# Optional LLM provider (Anthropic). Never expose this value in a frontend variable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional Google Gemini API. Gemini takes precedence when both LLM keys are present.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Live web search (Brave Search API). Create a key in your Brave Search API dashboard.
BRAVE_SEARCH_API_KEY=

# Global market quotes (Alpha Vantage). Free default quotes are end-of-day.
ALPHAVANTAGE_API_KEY=
# Optional US entitlement: realtime or delayed. Requires the matching paid market-data plan.
MARKET_DATA_ENTITLEMENT=

# Local embedding model. First run may download the model weights.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_ENABLED=true

# SEC asks API clients to identify themselves. Use a contact address per SEC guidance.
SEC_USER_AGENT=VenuFinAI contact@example.com

# Free official-source updates (India first, with selected global macro sources).
# The app refreshes configured feeds every 15 minutes while the backend is running.
NEWS_RSS_URLS=https://rbi.org.in/pressreleases_rss.xml,https://rbi.org.in/notifications_rss.xml,https://www.sebi.gov.in/sebirss.xml,https://nsearchives.nseindia.com/content/RSS/Online_announcements.xml,https://nsearchives.nseindia.com/content/RSS/Corporate_action.xml,https://www.federalreserve.gov/feeds/press_all.xml,https://www.sec.gov/news/pressreleases.rss,https://www.bls.gov/feed/cpi.rss

# Optional API integrations (leave blank unless licensed/authorized)
FRED_API_KEY=
MARKET_DATA_API_KEY=
NEWS_API_KEY=

MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MINUTE=60
